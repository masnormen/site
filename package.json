{
  "name": "site-tanstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:tsr": "dotenvx run --convention=nextjs -- vite dev --host",
    "dev:mdx": "dotenvx run --convention=nextjs -- tsx build-mdx.ts -w",
    "dev": "concurrently -c yellow,blue --pad-prefix pnpm:dev:mdx pnpm:dev:tsr",
    "build:tsr": "dotenvx run --convention=nextjs -- vite build",
    "build:mdx": "dotenvx run --convention=nextjs -- tsx build-mdx.ts",
    "build": "pnpm build:mdx && pnpm build:tsr",
    "start": "dotenvx run --convention=nextjs -- node .output/server/index.mjs",
    "lint": "oxlint --type-aware --type-check --quiet",
    "lint:fix": "oxlint --fix --type-aware --type-check --quiet",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "quality": "pnpm run --stream '/^(lint|format)$/'",
    "quality:fix": "pnpm run --stream '/^(lint:fix|format:fix)$/'",
    "typecheck": "dotenvx run --convention=nextjs -- tsc"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.0",
    "@giscus/react": "^3.1.0",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/react": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "^2.16.3",
    "@takumi-rs/helpers": "^2.16.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.3",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "jotai": "^3.0.1",
    "nitro": "3.0.260311-beta",
    "p-memoize": "^9.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-innertext": "^1.1.5",
    "react-medium-image-zoom": "^5.4.9",
    "sonner": "^2.0.8",
    "srvx": "^1.0.6",
    "tailwind-merge": "^3.7.0",
    "tiny-glob": "^0.2.9",
    "tw-to-css": "0.0.12",
    "zod": "^4.6.7"
